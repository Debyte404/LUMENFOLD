material {
    name : causticPool,
    shadingModel : unlit,
    blending : opaque,
    parameters : [
        { type : sampler2d, name : causticMap },
        { type : float, name : intensity }
    ],
    requires : [
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        vec2 uv = getUV0();
        vec3 c = texture(materialParams_causticMap, uv).rgb;
        float glow = max(c.r, max(c.g, c.b));
        // deep water base + warm caustic webs, tone friendlier than raw HDR
        vec3 base = vec3(0.015, 0.10, 0.22);
        vec3 warm = vec3(1.0, 0.93, 0.78);
        vec3 col = base + warm * c * materialParams.intensity;
        // soft sparkle lift on the brightest web cores
        col += vec3(0.9, 0.97, 1.0) * smoothstep(4.0, 8.0, glow) * 0.35;
        prepareMaterial(material);
        material.baseColor.rgb = col;
        material.emissive.rgb = col * 0.0;
    }
}
