material {
    name : waterSurface,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    doubleSided : true,
    parameters : [
        { type : float, name : time },
        { type : float3, name : tint }
    ],
    requires : [
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        vec2 uv = getUV0() * 6.0;
        float t = materialParams.time;
        // sum of moving sine ripples -> fake normal shimmer
        float w1 = sin(uv.x * 3.1 + t * 1.1) * cos(uv.y * 2.7 - t * 0.9);
        float w2 = sin((uv.x + uv.y) * 5.3 - t * 1.7);
        float glint = smoothstep(0.55, 1.0, w1 * 0.6 + w2 * 0.4);
        vec3 col = materialParams.tint * (0.25 + 0.35 * w1 * w1);
        col += vec3(0.9, 0.97, 1.0) * glint * 0.6;
        prepareMaterial(material);
        material.baseColor.rgb = col;
        // mostly see-through; alpha modest so floor caustics show through
        material.baseColor.a = 0.28 + 0.25 * glint;
    }
}
