<mujoco>
  <!-- Pool scene for two-medium physics + caustics demo.
       Water surface is NOT a MuJoCo medium (see #3452): the pool is visual +
       a contact floor; buoyancy comes from our two_medium wrapper as
       xfrc_applied computed from each body's pose vs surface z=0. -->
  <option timestep="0.002" gravity="0 0 -9.81" density="1.225" viscosity="1.8e-5"/>
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.9 0.9 0.9" rgb2="0.7 0.7 0.7"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.2"/>
    <material name="glass" rgba="0.7 0.9 1.0 0.4"/>
    <material name="hull" rgba="0.8 0.3 0.2 1.0"/>
    <material name="water" rgba="0.2 0.5 0.8 0.45"/>
  </asset>
  <worldbody>
    <light name="sun" pos="3 3 6" dir="-0.4 -0.4 -1" directional="true"/>
    <!-- pool floor at z=-1, walls; water surface plane z=0 handled in wrapper -->
    <geom name="pool_floor" type="plane" pos="0 0 -1" size="3 3 0.1" material="grid"/>
    <geom name="wall_n" type="box" pos="0 3 -0.5" size="3 0.1 0.5"/>
    <geom name="wall_s" type="box" pos="0 -3 -0.5" size="3 0.1 0.5"/>
    <geom name="wall_e" type="box" pos="3 0 -0.5" size="0.1 3 0.5"/>
    <geom name="wall_w" type="box" pos="-3 0 -0.5" size="0.1 3 0.5"/>
    <geom name="water_surface" type="plane" pos="0 0 0" size="3 3 0.1" material="water" contype="0" conaffinity="0"/>
    <!-- neutral-buoyancy sphere r=0.15 (mass 14.137167 kg), starts submerged -->
    <body name="float_sphere" pos="0 0 -0.4">
      <freejoint/>
      <geom name="float_sphere_g" type="sphere" size="0.15" mass="14.137167"/>
    </body>
    <!-- self-righting hull: box + dense keel below center -->
    <body name="hull" pos="1.2 0 -0.10" euler="30 0 0">
      <freejoint/>
      <geom name="hull_body" type="box" size="0.25 0.18 0.15" mass="20" material="hull"/>
      <geom name="keel" type="sphere" size="0.06" pos="0 0 -0.30" mass="8"/>
    </body>
    <!-- glass prism above water: the caustic caster -->
    <body name="prism" pos="-1.2 0 0.8" euler="0.3 0.2 0">
      <freejoint/>
      <geom name="prism_g" type="box" size="0.25 0.25 0.25" mass="2" material="glass"/>
    </body>
  </worldbody>
</mujoco>
