# archives + extracted prebuilts (re-fetch with tools/fetch_third_party.sh)
third_party/*.zip
third_party/*.tgz
third_party/*.tar.gz
third_party/mujoco-*/
third_party/filament-*/
# build output
build/
out/
dist/
*.egg-info
# python
__pycache__/
*.pyc
.venv/
# node
node_modules/
# editor
.vscode/
*.log
# stray object files
*.obj
# renders / frames
frames/
# Renders are gitignored by default -- they are large and regenerable -- but the
# images under docs/ ARE deliverables: the README and the documentation embed them
# and the paper references them. The earlier rules negated only docs/*.png and
# docs/figures/*.png, which left docs/media/*.png ignored, so an embedded figure
# silently failed to publish and showed as a broken image on the remote.
*.png
!docs/**
third_party/pbrt-v4/
third_party/luxvenv/

# editor/agent tool scratch (not part of the project)
.commandcode/
